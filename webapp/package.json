{
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "build:watch": "webpack --mode=production --watch",
    "debug": "webpack --mode=none",
    "debug:watch": "webpack --mode=development --watch",
    "lint": "eslint . --quiet --cache",
    "fix": "eslint . --quiet --fix --cache",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:watch": "jest --watch",
    "test-ci": "jest --forceExit --detectOpenHandles --maxWorkers=2",
    "check-types": "tsc"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@mattermost/client": "11.9.0",
    "@mattermost/types": "11.9.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "babel-loader": "10.1.1",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "css-loader": "7.1.5",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "7.1.14",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "style-loader": "4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1"
  },
  "dependencies": {
    "@mattermost/compass-icons": "0.1.67",
    "@mattermost/compass-ui": "0.1.0-alpha.15",
    "core-js": "3.51.0",
    "mattermost-redux": "11.9.0",
    "simplebar-react": "3.3.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost:8065"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/non_npm_dependencies/"
    ],
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "moduleNameMapper": {
      "^.+\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "identity-obj-proxy",
      "^.+\\.css$": "identity-obj-proxy",
      "^.*i18n.*\\.(json)$": "<rootDir>/tests/i18n_mock.json"
    },
    "moduleDirectories": [
      "src",
      "node_modules",
      "non_npm_dependencies"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@mattermost/compass-ui|@mattermost/compass-icons)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.tsx"
    ]
  },
  "overrides": {
    "eslint": "$eslint",
    "typescript": "$typescript"
  }
}
